{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chis Flasher",
  "version": "0.2.1",
  "identifier": "com.z.chis-flasher",
  "build": {
    "beforeDevCommand": "npm run ensure:cfb && npm run vite:single",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Chis Flasher",
        "width": 376,
        "height": 780,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; img-src 'self' data: https: blob: tauri: asset:; connect-src 'self' https://payload.gbmake.com https://g.gbmake.com https://admin.gbmake.com https://assets.gbmake.com http://localhost:* https://localhost:* ws://localhost:* ipc: http://ipc tauri:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/cfb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3REIzMjQwREQyM0ZEREEKUldUYS9TUGRRRExibHcvQ1dlbGN0a0NZRjBQeHQ1OEFXdkRiaCs1WGpYQjhjalhJUUdialdKYzQK",
      "endpoints": [
        "https://github.com/eyenobig/beggar_chis/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
